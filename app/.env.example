# Claude API key for the seven investor agents (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Model for the seven investor agents. Sonnet 5.5 is about half the cost of the default (claude-opus-5-5).
PM_MODEL=claude-sonnet-5-5
# Telem API key (https://app.telem.ai → API keys, service "Search & monitors"): the associate's live fact-checks
TELEM_API_KEY=
# Runware API key (https://my.runware.ai → API Keys): natural investor voices (Inworld TTS via Runware)
RUNWARE_API_KEY=
# Glasser API key (glasser.ai): the associate's pre-meeting diligence memo from live news
GLASSER_API_KEY=
# BAND agent API key (band.ai): mirrors the partners' private channel into a live BAND room
BAND_API_KEY=
# Optional: path to the Bruin CLI if it is not on PATH
BRUIN_BIN=
